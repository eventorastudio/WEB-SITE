rules_version = '2';

// Rules finales de Fase 4.7. El despliegue se controla exclusivamente mediante
// el archivo canónico indicado en firebase.json.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function hasInvitationEditorClaim() {
      return signedIn()
        && (
          ('role' in request.auth.token
            && request.auth.token.role in ['CEO', 'ADMINISTRADOR', 'ADMIN', 'DISENADOR'])
          || ('userRole' in request.auth.token
            && request.auth.token.userRole in ['CEO', 'ADMINISTRADOR', 'ADMIN', 'DISENADOR'])
        );
    }

    function isAllowedRole(role) {
      return role in ['cover', 'gallery', 'video', 'videoPoster', 'music'];
    }

    function isVersionedFileName(fileName) {
      return fileName.matches('^MED-LOCAL-[0-9]{3,}-[a-f0-9]{12}\\.(jpg|png|webp|mp4|webm|mp3|m4a|aac|ogg)$');
    }

    function typeMatchesRoleAndExtension(role, fileName) {
      return ((role == 'cover' || role == 'gallery' || role == 'videoPoster')
          && (
            (request.resource.contentType == 'image/jpeg' && fileName.matches('^.+\\.jpg$'))
            || (request.resource.contentType == 'image/png' && fileName.matches('^.+\\.png$'))
            || (request.resource.contentType == 'image/webp' && fileName.matches('^.+\\.webp$'))
          ))
        || (role == 'video'
          && (
            (request.resource.contentType == 'video/mp4' && fileName.matches('^.+\\.mp4$'))
            || (request.resource.contentType == 'video/webm' && fileName.matches('^.+\\.webm$'))
          ))
        || (role == 'music'
          && (
            (request.resource.contentType == 'audio/mpeg' && fileName.matches('^.+\\.mp3$'))
            || (request.resource.contentType == 'audio/mp4' && fileName.matches('^.+\\.m4a$'))
            || (request.resource.contentType == 'audio/aac' && fileName.matches('^.+\\.aac$'))
            || (request.resource.contentType == 'audio/ogg' && fileName.matches('^.+\\.ogg$'))
          ));
    }

    function hasMatchingMetadata(eventId, role, fileName) {
      return request.resource.metadata.eventId is string
        && request.resource.metadata.role is string
        && request.resource.metadata.mediaId is string
        && request.resource.metadata.eventId == eventId
        && request.resource.metadata.role == role
        && request.resource.metadata.mediaId.matches('^MED-LOCAL-[0-9]{3,}$')
        && fileName.matches('^' + request.resource.metadata.mediaId + '-[a-f0-9]{12}\\..+$');
    }

    function existingMetadataMatches(eventId, role) {
      return resource != null
        && resource.metadata.eventId is string
        && resource.metadata.role is string
        && resource.metadata.mediaId is string
        && resource.metadata.eventId == eventId
        && resource.metadata.role == role
        && resource.metadata.mediaId.matches('^MED-LOCAL-[0-9]{3,}$');
    }

    function isAllowedTypeAndSize(role) {
      return request.resource != null
        && (
          ((role == 'cover' || role == 'gallery' || role == 'videoPoster')
            && request.resource.contentType.matches('^image/(jpeg|png|webp)$')
            && request.resource.size > 0
            && request.resource.size <= 20 * 1024 * 1024)
          || (role == 'video'
            && request.resource.contentType.matches('^video/(mp4|webm)$')
            && request.resource.size > 0
            && request.resource.size <= 80 * 1024 * 1024)
          || (role == 'music'
            && request.resource.contentType.matches('^audio/(mpeg|mp4|aac|ogg)$')
            && request.resource.size > 0
            && request.resource.size <= 20 * 1024 * 1024)
        );
    }

    match /eventos/{eventId}/invitacion/media/{role}/{fileName} {
      allow read: if hasInvitationEditorClaim()
        && isAllowedRole(role)
        && isVersionedFileName(fileName)
        && existingMetadataMatches(eventId, role);

      // Cada binario usa un path inmutable; los reemplazos crean una nueva versión.
      allow create: if hasInvitationEditorClaim()
        && resource == null
        && isAllowedRole(role)
        && isVersionedFileName(fileName)
        && typeMatchesRoleAndExtension(role, fileName)
        && hasMatchingMetadata(eventId, role, fileName)
        && isAllowedTypeAndSize(role);
      allow update: if false;

      allow delete: if hasInvitationEditorClaim()
        && isAllowedRole(role)
        && isVersionedFileName(fileName)
        && existingMetadataMatches(eventId, role);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
