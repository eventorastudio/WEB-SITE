rules_version = '2';

// Rules locales hasta Fase 6.3. El despliegue se controla exclusivamente mediante
// el archivo canónico indicado en firebase.json.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasClaimedRole(roles) {
      return signedIn()
        && (
          ('role' in request.auth.token && request.auth.token.role in roles)
          || ('userRole' in request.auth.token && request.auth.token.userRole in roles)
        );
    }

    function isInternalReader() {
      return hasClaimedRole(['CEO', 'ADMINISTRADOR', 'ADMIN', 'DISENADOR', 'VENTAS', 'SOPORTE']);
    }

    function isPlatformManager() {
      return hasClaimedRole(['CEO', 'ADMINISTRADOR', 'ADMIN']);
    }

    function isThemeEditor() {
      return hasClaimedRole(['CEO', 'ADMINISTRADOR', 'ADMIN', 'DISENADOR']);
    }

    function validDraftSections(sections) {
      return sections is list
        && sections.size() <= 13
        && sections.toSet().size() == sections.size()
        && sections.toSet().hasOnly([
          'welcome-story', 'countdown', 'location', 'dress-code', 'rsvp',
          'music', 'welcome-video', 'gallery', 'gift-registry',
          'pass-selection', 'itinerary', 'access-preview',
          'advanced-personalization'
        ]);
    }

    function validDraftContent(content) {
      return content is map
        && content.keys().size() == 14
        && content.keys().hasOnly([
          'identity', 'schedule', 'place', 'welcome', 'countdown', 'location',
          'dressCode', 'music', 'video', 'gallery', 'gifts', 'passes',
          'itinerary', 'access'
        ])
        && content.identity is map
        && content.identity.keys().size() == 4
        && content.identity.keys().hasOnly(['primaryName', 'secondaryName', 'eventType', 'phrase'])
        && content.identity.primaryName is string
        && content.identity.secondaryName is string
        && content.identity.eventType is string
        && content.identity.phrase is string
        && content.schedule is map
        && content.schedule.keys().size() == 2
        && content.schedule.keys().hasOnly(['date', 'time'])
        && content.schedule.date is string
        && content.schedule.time is string
        && content.place is map
        && content.place.keys().size() == 2
        && content.place.keys().hasOnly(['city', 'state'])
        && content.place.city is string
        && content.place.state is string
        && content.welcome is map
        && content.welcome.keys().size() == 4
        && content.welcome.keys().hasOnly(['eyebrow', 'title', 'message', 'story'])
        && content.welcome.eyebrow is string
        && content.welcome.title is string
        && content.welcome.message is string
        && content.welcome.story is string
        && content.countdown is map
        && content.countdown.keys().size() == 3
        && content.countdown.keys().hasOnly(['title', 'preMessage', 'arrivedMessage'])
        && content.countdown.title is string
        && content.countdown.preMessage is string
        && content.countdown.arrivedMessage is string
        && content.location is map
        && content.location.keys().size() == 2
        && content.location.keys().hasOnly(['title', 'intro'])
        && content.location.title is string
        && content.location.intro is string
        && content.dressCode is map
        && content.dressCode.keys().size() == 6
        && content.dressCode.keys().hasOnly([
          'title', 'name', 'description', 'note', 'recommendedColors', 'avoidedColors'
        ])
        && content.dressCode.title is string
        && content.dressCode.name is string
        && content.dressCode.description is string
        && content.dressCode.note is string
        && content.dressCode.recommendedColors is list
        && content.dressCode.recommendedColors.size() <= 20
        && content.dressCode.avoidedColors is list
        && content.dressCode.avoidedColors.size() <= 20
        && content.music is map
        && content.music.keys().size() == 2
        && content.music.keys().hasOnly(['title', 'text'])
        && content.music.title is string
        && content.music.text is string
        && content.video is map
        && content.video.keys().size() == 3
        && content.video.keys().hasOnly(['title', 'subtitle', 'intro'])
        && content.video.title is string
        && content.video.subtitle is string
        && content.video.intro is string
        && content.gallery is map
        && content.gallery.keys().size() == 3
        && content.gallery.keys().hasOnly(['title', 'subtitle', 'description'])
        && content.gallery.title is string
        && content.gallery.subtitle is string
        && content.gallery.description is string
        && content.gifts is map
        && content.gifts.keys().size() == 3
        && content.gifts.keys().hasOnly(['title', 'description', 'ctaLabel'])
        && content.gifts.title is string
        && content.gifts.description is string
        && content.gifts.ctaLabel is string
        && content.passes is map
        && content.passes.keys().size() == 2
        && content.passes.keys().hasOnly(['title', 'instructions'])
        && content.passes.title is string
        && content.passes.instructions is string
        && content.itinerary is map
        && content.itinerary.keys().size() == 2
        && content.itinerary.keys().hasOnly(['title', 'intro'])
        && content.itinerary.title is string
        && content.itinerary.intro is string
        && content.access is map
        && content.access.keys().size() == 10
        && content.access.keys().hasOnly([
          'title', 'description', 'label', 'guestLabel', 'passesLabel',
          'showQr', 'showPrintPass', 'printButtonLabel', 'printTitle', 'printFooter'
        ])
        && content.access.title is string
        && content.access.description is string
        && content.access.label is string
        && content.access.guestLabel is string
        && content.access.passesLabel is string
        && content.access.showQr is bool
        && content.access.showPrintPass is bool
        && content.access.printButtonLabel is string
        && content.access.printTitle is string
        && content.access.printFooter is string;
    }

    function validInvitationSnapshot(data, eventId) {
      return data.eventId == eventId
        && data.eventId is string
        && data.eventId.matches('^[A-Za-z0-9_-]{1,150}$')
        && (
          data.theme == null
          || data.theme in [
            'aloha', 'luxury', 'botanical', 'midnight', 'romance', 'minimal',
            'celestial', 'vintage', 'garden', 'champagne', 'neon-party', 'custom'
          ]
        )
        && validDraftSections(data.sections)
        // The Builder/service performs canonical leaf validation before the write.
        // Rules keep the persisted content root structural contract here so this
        // authorization path stays below Firestore's per-request expression budget.
        && data.content is map
        && data.content.keys().size() == 14
        && data.content.keys().hasOnly([
          'identity', 'schedule', 'place', 'welcome', 'countdown', 'location',
          'dressCode', 'music', 'video', 'gallery', 'gifts', 'passes',
          'itinerary', 'access'
        ])
        && data.locations is list && data.locations.size() <= 20
        && data.itinerary is list && data.itinerary.size() <= 80
        && data.gifts is list && data.gifts.size() <= 50
        && data.accommodations is list && data.accommodations.size() <= 1
        && data.links is list && data.links.size() <= 50
        && validInvitationAppearance(data.appearance)
        && validInvitationSettings(data.settings);
    }

    // Revisions are written only through the publication service, whose schema
    // validator performs the deep field-by-field validation above before the
    // transaction starts. Rules repeat the strict persisted-root whitelist and
    // the bounded container checks without exhausting Firestore's per-request
    // expression budget for the two-document atomic write.
    function validInvitationRevisionSnapshot(data, eventId) {
      return data.eventId == eventId
        && data.eventId is string
        && data.eventId.matches('^[A-Za-z0-9_-]{1,150}$')
        && (
          data.theme == null
          || data.theme in [
            'aloha', 'luxury', 'botanical', 'midnight', 'romance', 'minimal',
            'celestial', 'vintage', 'garden', 'champagne', 'neon-party', 'custom'
          ]
        )
        && validDraftSections(data.sections)
        && data.content is map
        && data.content.keys().size() == 14
        && data.content.keys().hasOnly([
          'identity', 'schedule', 'place', 'welcome', 'countdown', 'location',
          'dressCode', 'music', 'video', 'gallery', 'gifts', 'passes',
          'itinerary', 'access'
        ])
        && data.locations is list && data.locations.size() <= 20
        && data.itinerary is list && data.itinerary.size() <= 80
        && data.gifts is list && data.gifts.size() <= 50
        && data.accommodations is list && data.accommodations.size() <= 1
        && data.links is list && data.links.size() <= 50
        && validInvitationAppearance(data.appearance)
        && validInvitationSettings(data.settings);
    }

    function validInvitationSettings(settings) {
      return settings is map
        && (
          (
            settings.keys().size() == 2
            && settings.keys().hasOnly(['renderMode', 'packageId'])
          )
          || (
            settings.keys().size() == 3
            && settings.keys().hasOnly(['renderMode', 'packageId', 'format'])
            && settings.format in ['website', 'stories', 'cards']
          )
        )
        && settings.renderMode == 'builder'
        && (
          settings.packageId == null
          || settings.packageId in ['esencial', 'premium', 'prestige']
        );
    }

    function validInvitationAppearance(appearance) {
      return appearance is map
        && (
          appearance.keys().size() == 0
          || (
            appearance.keys().size() == 1
            && appearance.keys().hasOnly(['accentColor'])
            && appearance.accentColor is string
            && appearance.accentColor.matches('^#[0-9a-f]{6}$')
          )
        );
    }

    function validInvitationDraftWrite(eventId) {
      let data = request.resource.data;
      return data.keys().size() == 15
        && data.keys().hasOnly([
          'schemaVersion', 'contentSchemaVersion', 'eventId', 'theme',
          'sections', 'content', 'locations', 'itinerary', 'gifts',
          'accommodations', 'links', 'appearance', 'settings', 'updatedAt',
          'updatedBy'
        ])
        && data.schemaVersion == 2
        && data.contentSchemaVersion == 4
        && validInvitationSnapshot(data, eventId)
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    function invitationPublicationPath(eventId) {
      return /databases/$(database)/documents/eventos/$(eventId)/invitacion/publication;
    }

    function invitationRevisionPath(eventId, revisionId) {
      return /databases/$(database)/documents/eventos/$(eventId)/invitacion/publication/revisions/$(revisionId);
    }

    function invitationPublicProjectionPath(eventId, publicKey) {
      return /databases/$(database)/documents/eventos/$(eventId)/invitacionPublic/$(publicKey);
    }

    function validInvitationRevisionId(revisionId) {
      return revisionId is string && revisionId.matches('^REV-[0-9]{6,}$');
    }

    function validInvitationPublicKey(publicKey) {
      return publicKey is string && publicKey.matches('^[a-f0-9]{48}$');
    }

    function validInvitationPublicationMetadata(data, eventId) {
      return data is map
        && data.keys().size() == 7
        && data.keys().hasOnly([
          'schemaVersion', 'eventId', 'currentRevisionId',
          'currentRevisionNumber', 'publicKey', 'publishedAt', 'publishedBy'
        ])
        && data.schemaVersion == 2
        && data.eventId == eventId
        && validInvitationRevisionId(data.currentRevisionId)
        && data.currentRevisionNumber is int
        && data.currentRevisionNumber >= 1
        && data.currentRevisionNumber <= 999999999
        && validInvitationPublicKey(data.publicKey)
        && data.publishedAt is timestamp
        && data.publishedBy is string;
    }

    function publicationPointsToRevision(data, eventId) {
      let path = invitationRevisionPath(eventId, data.currentRevisionId);
      return existsAfter(path)
        && getAfter(path).data.eventId == eventId
        && getAfter(path).data.revisionNumber == data.currentRevisionNumber
        && getAfter(path).data.publishedAt == data.publishedAt
        && getAfter(path).data.publishedBy == data.publishedBy;
    }

    function publicationPointsToPublicProjection(data, eventId) {
      let path = invitationPublicProjectionPath(eventId, data.publicKey);
      return existsAfter(path)
        && getAfter(path).data.eventId == eventId
        && getAfter(path).data.publicKey == data.publicKey
        && getAfter(path).data.revisionId == data.currentRevisionId
        && getAfter(path).data.revisionNumber == data.currentRevisionNumber;
    }

    function validInvitationPublicationCreate(eventId) {
      let data = request.resource.data;
      return validInvitationPublicationMetadata(data, eventId)
        && data.currentRevisionNumber == 1
        && data.publishedAt == request.time
        && data.publishedBy == request.auth.uid
        && publicationPointsToRevision(data, eventId)
        && publicationPointsToPublicProjection(data, eventId);
    }

    function validInvitationPublicationUpdate(eventId) {
      let data = request.resource.data;
      return validInvitationPublicationMetadata(data, eventId)
        && (
          (
            data.currentRevisionNumber == resource.data.currentRevisionNumber + 1
            && data.currentRevisionId != resource.data.currentRevisionId
            && data.publishedAt == request.time
            && data.publishedBy == request.auth.uid
            && (
              resource.data.schemaVersion == 1
              || (resource.data.schemaVersion == 2 && data.publicKey == resource.data.publicKey)
            )
          )
          || (
            resource.data.schemaVersion == 1
            && data.currentRevisionNumber == resource.data.currentRevisionNumber
            && data.currentRevisionId == resource.data.currentRevisionId
            && data.publishedAt == resource.data.publishedAt
            && data.publishedBy == resource.data.publishedBy
          )
        )
        && publicationPointsToRevision(data, eventId)
        && publicationPointsToPublicProjection(data, eventId);
    }

    function validInvitationRevisionCreate(eventId, revisionId) {
      let data = request.resource.data;
      let publicationPath = invitationPublicationPath(eventId);
      return data.keys().size() == 16
        && data.keys().hasOnly([
          'schemaVersion', 'contentSchemaVersion', 'eventId', 'revisionNumber',
          'theme', 'sections', 'content', 'locations', 'itinerary', 'gifts',
          'accommodations', 'links', 'appearance', 'settings', 'publishedAt',
          'publishedBy'
        ])
        && data.schemaVersion == 1
        && data.contentSchemaVersion == 4
        && validInvitationRevisionSnapshot(data, eventId)
        && data.revisionNumber is int
        && data.revisionNumber >= 1
        && data.revisionNumber <= 999999999
        && validInvitationRevisionId(revisionId)
        && data.publishedAt == request.time
        && data.publishedBy == request.auth.uid
        && existsAfter(publicationPath)
        && getAfter(publicationPath).data.currentRevisionId == revisionId
        && getAfter(publicationPath).data.currentRevisionNumber == data.revisionNumber
        && getAfter(publicationPath).data.publishedAt == data.publishedAt
        && getAfter(publicationPath).data.publishedBy == data.publishedBy;
    }

    function validInvitationPublicMedia(media) {
      return media is map
        && (
          (media.keys().size() == 7
            && media.keys().hasOnly(['schemaVersion', 'touchedRoles', 'cover', 'gallery', 'video', 'videoPoster', 'music']))
          || (media.keys().size() == 8
            && media.keys().hasOnly(['schemaVersion', 'touchedRoles', 'cover', 'gallery', 'dressCode', 'video', 'videoPoster', 'music']))
        )
        && media.schemaVersion == 1
        && media.touchedRoles is list
        && media.touchedRoles.size() <= 6
        && media.touchedRoles.toSet().size() == media.touchedRoles.size()
        && media.touchedRoles.toSet().hasOnly(['cover', 'gallery', 'dressCode', 'video', 'videoPoster', 'music'])
        && (media.cover == null || media.cover is map)
        && media.gallery is list
        && media.gallery.size() <= 20
        && (!('dressCode' in media) || media.dressCode == null || media.dressCode is map)
        && (media.video == null || media.video is map)
        && (media.videoPoster == null || media.videoPoster is map)
        && (media.music == null || media.music is map);
    }

    function validInvitationPublicProjection(eventId, publicKey) {
      let data = request.resource.data;
      let publicationPath = invitationPublicationPath(eventId);
      return data.keys().size() == 17
        && data.keys().hasOnly([
          'schemaVersion', 'contentSchemaVersion', 'eventId', 'publicKey',
          'revisionId', 'revisionNumber', 'theme', 'sections', 'content',
          'locations', 'itinerary', 'gifts', 'accommodations', 'links',
          'appearance', 'settings', 'media'
        ])
        && data.schemaVersion == 1
        && data.contentSchemaVersion == 4
        && data.publicKey == publicKey
        && validInvitationPublicKey(publicKey)
        && validInvitationRevisionSnapshot(data, eventId)
        && !('pass-selection' in data.sections)
        && data.revisionNumber is int
        && data.revisionNumber >= 1
        && data.revisionNumber <= 999999999
        && validInvitationRevisionId(data.revisionId)
        && validInvitationPublicMedia(data.media)
        && existsAfter(publicationPath)
        && getAfter(publicationPath).data.publicKey == publicKey
        && getAfter(publicationPath).data.currentRevisionId == data.revisionId
        && getAfter(publicationPath).data.currentRevisionNumber == data.revisionNumber;
    }

    function validMediaId(mediaId) {
      return mediaId is string && mediaId.matches('^MED-LOCAL-[0-9]{3,}$');
    }

    function validOptionalMediaId(mediaId) {
      return mediaId == null ? true : validMediaId(mediaId);
    }

    function validGalleryIds(galleryIds) {
      return galleryIds is list
        && galleryIds.size() <= 20
        && galleryIds.toSet().size() == galleryIds.size()
        && (galleryIds.size() < 1 ? true : validMediaId(galleryIds[0]))
        && (galleryIds.size() < 2 ? true : validMediaId(galleryIds[1]))
        && (galleryIds.size() < 3 ? true : validMediaId(galleryIds[2]))
        && (galleryIds.size() < 4 ? true : validMediaId(galleryIds[3]))
        && (galleryIds.size() < 5 ? true : validMediaId(galleryIds[4]))
        && (galleryIds.size() < 6 ? true : validMediaId(galleryIds[5]))
        && (galleryIds.size() < 7 ? true : validMediaId(galleryIds[6]))
        && (galleryIds.size() < 8 ? true : validMediaId(galleryIds[7]))
        && (galleryIds.size() < 9 ? true : validMediaId(galleryIds[8]))
        && (galleryIds.size() < 10 ? true : validMediaId(galleryIds[9]))
        && (galleryIds.size() < 11 ? true : validMediaId(galleryIds[10]))
        && (galleryIds.size() < 12 ? true : validMediaId(galleryIds[11]))
        && (galleryIds.size() < 13 ? true : validMediaId(galleryIds[12]))
        && (galleryIds.size() < 14 ? true : validMediaId(galleryIds[13]))
        && (galleryIds.size() < 15 ? true : validMediaId(galleryIds[14]))
        && (galleryIds.size() < 16 ? true : validMediaId(galleryIds[15]))
        && (galleryIds.size() < 17 ? true : validMediaId(galleryIds[16]))
        && (galleryIds.size() < 18 ? true : validMediaId(galleryIds[17]))
        && (galleryIds.size() < 19 ? true : validMediaId(galleryIds[18]))
        && (galleryIds.size() < 20 ? true : validMediaId(galleryIds[19]));
    }

    function singularIdsAreDistinct(index) {
      return (!('dressCodeId' in index) || index.dressCodeId == null || index.coverId == null || index.dressCodeId != index.coverId)
        && (!('dressCodeId' in index) || index.dressCodeId == null || index.videoId == null || index.dressCodeId != index.videoId)
        && (!('dressCodeId' in index) || index.dressCodeId == null || index.posterId == null || index.dressCodeId != index.posterId)
        && (!('dressCodeId' in index) || index.dressCodeId == null || index.audioId == null || index.dressCodeId != index.audioId)
        && (!('dressCodeId' in index) || index.dressCodeId == null || !(index.dressCodeId in index.galleryIds))
        && (index.coverId == null || index.videoId == null || index.coverId != index.videoId)
        && (index.coverId == null || index.posterId == null || index.coverId != index.posterId)
        && (index.coverId == null || index.audioId == null || index.coverId != index.audioId)
        && (index.videoId == null || index.posterId == null || index.videoId != index.posterId)
        && (index.videoId == null || index.audioId == null || index.videoId != index.audioId)
        && (index.posterId == null || index.audioId == null || index.posterId != index.audioId)
        && (index.coverId == null ? true : !(index.coverId in index.galleryIds))
        && (index.videoId == null ? true : !(index.videoId in index.galleryIds))
        && (index.posterId == null ? true : !(index.posterId in index.galleryIds))
        && (index.audioId == null ? true : !(index.audioId in index.galleryIds));
    }

    function validMediaIndex(index) {
      return index is map
        && (
          (index.keys().size() == 6
            && index.keys().hasOnly(['schemaVersion', 'coverId', 'galleryIds', 'videoId', 'posterId', 'audioId']))
          || (index.keys().size() == 7
            && index.keys().hasOnly(['schemaVersion', 'coverId', 'galleryIds', 'dressCodeId', 'videoId', 'posterId', 'audioId']))
        )
        && index.schemaVersion == 1
        && validOptionalMediaId(index.coverId)
        && (!('dressCodeId' in index) || validOptionalMediaId(index.dressCodeId))
        && validOptionalMediaId(index.videoId)
        && validOptionalMediaId(index.posterId)
        && validOptionalMediaId(index.audioId)
        && validGalleryIds(index.galleryIds)
        && singularIdsAreDistinct(index);
    }

    function validInvitationConfigWrite() {
      let data = request.resource.data;
      return data.keys().size() == 4
        && data.keys().hasOnly(['schemaVersion', 'mediaIndex', 'updatedAt', 'updatedBy'])
        && data.schemaVersion == 5
        && validMediaIndex(data.mediaIndex)
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    function validRsvpTouchedPaths(paths) {
      return paths is list
        && paths.size() <= 14
        && paths.toSet().size() == paths.size()
        && paths.toSet().hasOnly([
          'content.rsvp.enabled',
          'content.rsvp.title',
          'content.rsvp.message',
          'content.rsvp.buttonLabel',
          'content.rsvp.deadline',
          'content.rsvp.deadlineTime',
          'content.rsvp.deadlineTimeZone',
          'content.rsvp.method',
          'content.rsvp.whatsapp.phone',
          'content.rsvp.whatsapp.message',
          'content.rsvp.guestPolicy',
          'content.rsvp.responses.acceptedLabel',
          'content.rsvp.responses.declinedLabel',
          'content.rsvp.responses.confirmationMessage'
        ]);
    }

    function validRsvpDeadline(data) {
      return (
          data.deadline == ''
          && data.deadlineTime == ''
          && data.deadlineTimeZone == ''
          && data.responseClosesAt == null
        ) || (
          data.deadline.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && data.deadlineTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && data.deadlineTimeZone.matches('^(UTC|[A-Za-z_]+(/[A-Za-z0-9._+-]+)+)$')
          && !data.deadlineTimeZone.matches('^Etc/GMT[+-].*$')
          && data.responseClosesAt is timestamp
        );
    }

    function validRsvpWrite(eventId) {
      let data = request.resource.data;
      return data.keys().size() == 18
        && data.keys().hasOnly([
          'schemaVersion', 'contentSchemaVersion', 'eventId', 'enabled', 'title',
          'message', 'buttonLabel', 'deadline', 'deadlineTime',
          'deadlineTimeZone', 'responseClosesAt', 'method', 'whatsapp',
          'guestPolicy', 'responses', 'touchedPaths', 'updatedAt', 'updatedBy'
        ])
        && data.schemaVersion == 2
        && data.contentSchemaVersion == 4
        && data.eventId is string
        && data.eventId == eventId
        && data.eventId.matches('^[A-Za-z0-9_-]{1,150}$')
        && data.enabled is bool
        && data.title is string && data.title.size() <= 120
        && data.message is string && data.message.size() <= 500
        && data.buttonLabel is string && data.buttonLabel.size() <= 80
        && data.deadline is string && data.deadline.size() <= 10
        && data.deadlineTime is string && data.deadlineTime.size() <= 5
        && data.deadlineTimeZone is string && data.deadlineTimeZone.size() <= 100
        && validRsvpDeadline(data)
        && data.method in ['whatsapp', 'internal']
        && data.whatsapp is map
        && data.whatsapp.keys().size() == 2
        && data.whatsapp.keys().hasOnly(['phone', 'message'])
        && data.whatsapp.phone is string && data.whatsapp.phone.size() <= 32
        && data.whatsapp.message is string && data.whatsapp.message.size() <= 1000
        && (data.method != 'whatsapp' || data.whatsapp.phone.matches('^\\+?[0-9 ()-]{7,32}$'))
        && data.guestPolicy in ['assigned-only', 'select-up-to-assigned']
        && data.responses is map
        && data.responses.keys().size() == 3
        && data.responses.keys().hasOnly(['acceptedLabel', 'declinedLabel', 'confirmationMessage'])
        && data.responses.acceptedLabel is string && data.responses.acceptedLabel.size() <= 120
        && data.responses.declinedLabel is string && data.responses.declinedLabel.size() <= 120
        && data.responses.confirmationMessage is string && data.responses.confirmationMessage.size() <= 500
        && validRsvpTouchedPaths(data.touchedPaths)
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    function validRsvpAccessToken(token) {
      return token is string && token.matches('^[A-Za-z0-9_-]{43}$');
    }

    function validRsvpConfigKey(configKey) {
      return configKey is string && configKey.matches('^[A-Za-z0-9_-]{43}$');
    }

    function rsvpPublicationPath(eventId) {
      return /databases/$(database)/documents/eventos/$(eventId)/invitacion/rsvpPublication;
    }

    function rsvpAccessPath(eventId, token) {
      return /databases/$(database)/documents/eventos/$(eventId)/rsvpAccess/$(token);
    }

    function rsvpPublicPath(eventId, configKey) {
      return /databases/$(database)/documents/eventos/$(eventId)/rsvpPublic/$(configKey);
    }

    function validRsvpPublicationDocument(data, eventId) {
      return data is map
        && data.keys().size() == 7
        && data.keys().hasOnly([
          'schemaVersion', 'eventId', 'configKey', 'createdAt', 'createdBy',
          'updatedAt', 'updatedBy'
        ])
        && data.schemaVersion == 1
        && data.eventId == eventId
        && validRsvpConfigKey(data.configKey)
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.createdBy.size() <= 128
        && data.updatedAt is timestamp
        && data.updatedBy is string
        && data.updatedBy.size() > 0
        && data.updatedBy.size() <= 128;
    }

    function validRsvpPublicationCreate(eventId) {
      let data = request.resource.data;
      return validRsvpPublicationDocument(data, eventId)
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.createdBy == request.auth.uid
        && data.updatedBy == request.auth.uid;
    }

    function validRsvpPublicationUpdate(eventId) {
      let before = resource.data;
      let after = request.resource.data;
      return validRsvpPublicationDocument(after, eventId)
        && after.schemaVersion == before.schemaVersion
        && after.eventId == before.eventId
        && after.configKey == before.configKey
        && after.createdAt == before.createdAt
        && after.createdBy == before.createdBy
        && after.updatedAt == request.time
        && after.updatedBy == request.auth.uid
        && after.diff(before).affectedKeys().hasOnly(['updatedAt', 'updatedBy']);
    }

    function validRsvpPublicConfigDocument(data, eventId) {
      return data is map
        && data.keys().size() == 12
        && data.keys().hasOnly([
          'schemaVersion', 'eventId', 'enabled', 'title', 'message',
          'buttonLabel', 'method', 'guestPolicy', 'responses', 'whatsapp',
          'deadlineTimeZone', 'responseClosesAt'
        ])
        && data.schemaVersion == 1
        && data.eventId == eventId
        && data.enabled is bool
        && data.title is string && data.title.size() <= 120
        && data.message is string && data.message.size() <= 500
        && data.buttonLabel is string && data.buttonLabel.size() <= 80
        && data.method in ['internal', 'whatsapp']
        && data.guestPolicy in ['assigned-only', 'select-up-to-assigned']
        && data.responses is map
        && data.responses.keys().size() == 3
        && data.responses.keys().hasOnly(['acceptedLabel', 'declinedLabel', 'confirmationMessage'])
        && data.responses.acceptedLabel is string && data.responses.acceptedLabel.size() <= 120
        && data.responses.declinedLabel is string && data.responses.declinedLabel.size() <= 120
        && data.responses.confirmationMessage is string && data.responses.confirmationMessage.size() <= 500
        && data.whatsapp is map
        && data.whatsapp.keys().size() == 2
        && data.whatsapp.keys().hasOnly(['phone', 'message'])
        && data.whatsapp.phone is string && data.whatsapp.phone.size() <= 32
        && data.whatsapp.message is string && data.whatsapp.message.size() <= 1000
        && (data.method != 'whatsapp' || data.whatsapp.phone.matches('^\\+?[0-9 ()-]{7,32}$'))
        && data.deadlineTimeZone is string && data.deadlineTimeZone.size() <= 100
        && (
          (data.responseClosesAt == null && data.deadlineTimeZone == '')
          || (
            data.responseClosesAt is timestamp
            && data.deadlineTimeZone.matches('^(UTC|[A-Za-z_]+(/[A-Za-z0-9._+-]+)+)$')
            && !data.deadlineTimeZone.matches('^Etc/GMT[+-].*$')
          )
        );
    }

    function validRsvpPublicConfigWrite(eventId, configKey) {
      return validRsvpConfigKey(configKey)
        && validRsvpPublicConfigDocument(request.resource.data, eventId);
    }

    function validPublicRsvpConfigGet(eventId, configKey) {
      return validRsvpConfigKey(configKey)
        && validRsvpPublicConfigDocument(resource.data, eventId)
        && resource.data.enabled == true;
    }

    function validRsvpAccessDocument(data, eventId) {
      return data is map
        && data.keys().size() == 8
        && data.keys().hasOnly([
          'schemaVersion', 'eventId', 'guestId', 'displayName', 'passLimit',
          'active', 'expiresAt', 'configKey'
        ])
        && data.schemaVersion == 2
        && data.eventId is string
        && data.eventId == eventId
        && data.eventId.matches('^[A-Za-z0-9_-]{1,150}$')
        && data.guestId is string
        && data.guestId.size() > 0
        && data.guestId.size() <= 1500
        && data.guestId.matches('^[^/]+$')
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 160
        && data.passLimit is int
        && data.passLimit >= 1
        && data.passLimit <= 999
        && validRsvpConfigKey(data.configKey)
        && data.active is bool
        && (data.expiresAt == null || data.expiresAt is timestamp);
    }

    function validRsvpAccessCreate(eventId, token) {
      let data = request.resource.data;
      return isThemeEditor()
        && validRsvpAccessToken(token)
        && validRsvpAccessDocument(data, eventId)
        && exists(rsvpPublicationPath(eventId))
        && validRsvpPublicationDocument(get(rsvpPublicationPath(eventId)).data, eventId)
        && get(rsvpPublicationPath(eventId)).data.configKey == data.configKey;
    }

    function validRsvpAccessUpdate(eventId, token) {
      let before = resource.data;
      let after = request.resource.data;
      return isThemeEditor()
        && validRsvpAccessToken(token)
        && validRsvpAccessDocument(after, eventId)
        && after.schemaVersion == before.schemaVersion
        && after.eventId == before.eventId
        && after.guestId == before.guestId
        && after.configKey == before.configKey
        && after.diff(before).affectedKeys().hasOnly([
          'displayName', 'passLimit', 'active', 'expiresAt'
        ]);
    }

    function validPublicRsvpAccessGet(eventId, token) {
      return validRsvpAccessToken(token)
        && validRsvpAccessDocument(resource.data, eventId)
        && resource.data.active == true
        && (resource.data.expiresAt == null || request.time < resource.data.expiresAt);
    }

    function validRsvpResponseDocument(data, eventId, access, config) {
      return data is map
        && data.keys().size() == 6
        && data.keys().hasOnly([
          'schemaVersion', 'eventId', 'guestId', 'status',
          'passesConfirmed', 'respondedAt'
        ])
        && data.schemaVersion == 1
        && data.eventId == eventId
        && data.guestId == access.guestId
        && data.status in ['accepted', 'declined']
        && data.passesConfirmed is int
        && data.passesConfirmed >= 0
        && data.passesConfirmed <= access.passLimit
        && data.respondedAt is timestamp
        && (
          (data.status == 'declined' && data.passesConfirmed == 0)
          || (
            data.status == 'accepted'
            && (
              (config.guestPolicy == 'assigned-only' && data.passesConfirmed == access.passLimit)
              || (
                config.guestPolicy == 'select-up-to-assigned'
                && data.passesConfirmed >= 1
                && data.passesConfirmed <= access.passLimit
              )
            )
          )
        );
    }

    function validRsvpResponseContext(eventId, token, access, config) {
      return validRsvpAccessToken(token)
        && validRsvpAccessDocument(access, eventId)
        && access.active == true
        && (access.expiresAt == null || request.time < access.expiresAt)
        && validRsvpPublicConfigDocument(config, eventId)
        && config.enabled == true;
    }

    function validPublicRsvpResponseGet(eventId, token) {
      let access = get(rsvpAccessPath(eventId, token)).data;
      let config = get(rsvpPublicPath(eventId, access.configKey)).data;
      return validRsvpResponseContext(eventId, token, access, config)
        && validRsvpResponseDocument(resource.data, eventId, access, config);
    }

    function validPublicRsvpResponseWrite(eventId, token) {
      let access = get(rsvpAccessPath(eventId, token)).data;
      let config = get(rsvpPublicPath(eventId, access.configKey)).data;
      return validRsvpResponseContext(eventId, token, access, config)
        && config.method == 'internal'
        && (config.responseClosesAt == null || request.time < config.responseClosesAt)
        && validRsvpResponseDocument(request.resource.data, eventId, access, config)
        && request.resource.data.respondedAt == request.time;
    }

    function validPublicRsvpResponseUpdate(eventId, token) {
      let before = resource.data;
      let after = request.resource.data;
      return validPublicRsvpResponseWrite(eventId, token)
        && after.schemaVersion == before.schemaVersion
        && after.eventId == before.eventId
        && after.guestId == before.guestId
        && after.diff(before).affectedKeys().hasOnly([
          'status', 'passesConfirmed', 'respondedAt'
        ]);
    }

    function validInternalRsvpResponseMigration(eventId, token) {
      let access = get(rsvpAccessPath(eventId, token)).data;
      let config = get(rsvpPublicPath(eventId, access.configKey)).data;
      return isThemeEditor()
        && validRsvpAccessToken(token)
        && validRsvpAccessDocument(access, eventId)
        && validRsvpPublicConfigDocument(config, eventId)
        && validRsvpResponseDocument(request.resource.data, eventId, access, config)
        && request.resource.data.respondedAt <= request.time;
    }

    function validMediaDocumentCore(data, eventId, mediaId) {
      return data.keys().size() == 17
        && data.keys().hasOnly([
          'id', 'role', 'kind', 'originalName', 'mimeType', 'size', 'width',
          'height', 'duration', 'alt', 'caption', 'storagePath', 'focalPoint',
          'objectVersion', 'createdAt', 'updatedAt', 'updatedBy'
        ])
        && validMediaId(mediaId)
        && data.id == mediaId
        && data.role in ['cover', 'gallery', 'dressCode', 'video', 'videoPoster', 'music']
        && data.originalName is string && data.originalName.size() <= 180
        && data.size > 0
        && data.width >= 0
        && data.height >= 0
        && data.duration >= 0
        && data.alt is string && data.alt.size() <= 220
        && data.caption is string && data.caption.size() <= 360
        && data.objectVersion is string && data.objectVersion.matches('^[a-f0-9]{12}$')
        && data.storagePath is string
        && data.storagePath.matches('^eventos/' + eventId + '/invitacion/media/' + data.role + '/' + mediaId + '-' + data.objectVersion + '\\.(jpg|png|webp|mp4|webm|mp3|m4a|aac|ogg)$')
        && data.focalPoint is map
        && data.focalPoint.keys().size() == 2
        && data.focalPoint.keys().hasOnly(['x', 'y'])
        && data.focalPoint.x >= 0 && data.focalPoint.x <= 100
        && data.focalPoint.y >= 0 && data.focalPoint.y <= 100
        && data.createdAt is timestamp
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    function validMediaDocumentType(data) {
      return ((data.role == 'cover' || data.role == 'gallery' || data.role == 'dressCode' || data.role == 'videoPoster')
          && data.kind == 'image'
          && data.size <= 20 * 1024 * 1024
          && data.width > 0
          && data.height > 0
          && data.duration == 0
          && (
            (data.mimeType == 'image/jpeg' && data.storagePath.matches('^.+\\.jpg$'))
            || (data.mimeType == 'image/png' && data.storagePath.matches('^.+\\.png$'))
            || (data.mimeType == 'image/webp' && data.storagePath.matches('^.+\\.webp$'))
          ))
        || (data.role == 'video'
          && data.kind == 'video'
          && data.size <= 80 * 1024 * 1024
          && data.width > 0
          && data.height > 0
          && data.duration > 0
          && data.duration <= 5 * 60
          && (
            (data.mimeType == 'video/mp4' && data.storagePath.matches('^.+\\.mp4$'))
            || (data.mimeType == 'video/webm' && data.storagePath.matches('^.+\\.webm$'))
          ))
        || (data.role == 'music'
          && data.kind == 'audio'
          && data.size <= 20 * 1024 * 1024
          && data.width == 0
          && data.height == 0
          && data.duration > 0
          && data.duration <= 15 * 60
          && (
            (data.mimeType == 'audio/mpeg' && data.storagePath.matches('^.+\\.mp3$'))
            || (data.mimeType == 'audio/mp4' && data.storagePath.matches('^.+\\.m4a$'))
            || (data.mimeType == 'audio/aac' && data.storagePath.matches('^.+\\.aac$'))
            || (data.mimeType == 'audio/ogg' && data.storagePath.matches('^.+\\.ogg$'))
          ));
    }

    function validMediaDocumentCreate(eventId, mediaId) {
      return validMediaDocumentCore(request.resource.data, eventId, mediaId)
        && validMediaDocumentType(request.resource.data)
        && request.resource.data.createdAt == request.time;
    }

    function validMediaDocumentUpdate(eventId, mediaId) {
      return validMediaDocumentCore(request.resource.data, eventId, mediaId)
        && validMediaDocumentType(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function profilePath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function eventPath(eventId) {
      return /databases/$(database)/documents/eventos/$(eventId);
    }

    function guestPath(eventId, guestId) {
      return /databases/$(database)/documents/eventos/$(eventId)/invitados/$(guestId);
    }

    function checkinPath(eventId, checkinId) {
      return /databases/$(database)/documents/eventos/$(eventId)/checkins/$(checkinId);
    }

    function isActivePortalClient() {
      return signedIn()
        && get(profilePath()).data.activo == true
        && get(profilePath()).data.rol == 'cliente'
        && get(profilePath()).data.eventosPermitidos is list;
    }

    function portalEnabled(eventId) {
      return isActivePortalClient()
        && eventId in get(profilePath()).data.eventosPermitidos
        && get(eventPath(eventId)).data.funcionalidades is map
        && get(eventPath(eventId)).data.funcionalidades.portalCliente == true;
    }

    function checkinEnabled(eventId) {
      return portalEnabled(eventId)
        && get(eventPath(eventId)).data.funcionalidades.checkInQR == true;
    }

    function historyEnabled(eventId) {
      return portalEnabled(eventId)
        && get(eventPath(eventId)).data.funcionalidades.historialAccesos == true;
    }

    function checkinIdMatchesGuest(checkinId, guestId) {
      return guestId.matches('^INV-[0-9]{4,}$')
        && checkinId.matches('^' + guestId + '-[0-9]{3,}$');
    }

    function keepsFirstArrival(before, after) {
      return before.keys().hasAll(['horaLlegada']) && before.horaLlegada != null
        ? after.horaLlegada == before.horaLlegada
        : after.horaLlegada == request.time;
    }

    function validExistingPassState(guest) {
      return guest.pases is int
        && guest.pases > 0
        && guest.pasesUtilizados is int
        && guest.pasesDisponibles is int
        && guest.pasesUtilizados >= 0
        && guest.pasesDisponibles >= 0
        && guest.pasesUtilizados + guest.pasesDisponibles == guest.pases;
    }

    function validPortalGuestCheckin(eventId, guestId) {
      let before = resource.data;
      let after = request.resource.data;
      let historyPath = checkinPath(eventId, after.ultimoCheckinId);
      return checkinEnabled(eventId)
        && after.diff(before).affectedKeys().hasOnly([
          'pasesUtilizados',
          'pasesDisponibles',
          'llegadaRegistrada',
          'horaLlegada',
          'estado',
          'checkinSecuencia',
          'ultimoCheckinId',
          'fechaActualizacion'
        ])
        && validExistingPassState(before)
        && before.checkinSecuencia is int
        && before.checkinSecuencia >= 0
        && after.checkinSecuencia == before.checkinSecuencia + 1
        && after.ultimoCheckinId is string
        && after.ultimoCheckinId != before.get('ultimoCheckinId', '')
        && checkinIdMatchesGuest(after.ultimoCheckinId, guestId)
        && after.pasesUtilizados is int
        && after.pasesDisponibles is int
        && after.pasesUtilizados > before.pasesUtilizados
        && after.pasesUtilizados <= before.pases
        && after.pasesDisponibles >= 0
        && after.pasesUtilizados + after.pasesDisponibles == before.pases
        && after.pasesDisponibles < before.pasesDisponibles
        && after.pasesUtilizados - before.pasesUtilizados
          == before.pasesDisponibles - after.pasesDisponibles
        && after.pasesUtilizados - before.pasesUtilizados <= 999
        && after.llegadaRegistrada == true
        && after.estado == 'llego'
        && keepsFirstArrival(before, after)
        && after.fechaActualizacion == request.time
        && !exists(historyPath)
        && existsAfter(historyPath)
        && getAfter(historyPath).data.invitadoId == guestId
        && getAfter(historyPath).data.checkinSecuencia == after.checkinSecuencia;
    }

    function checkinMatchesGuestAfter(eventId, checkinId, record) {
      let path = guestPath(eventId, record.invitadoId);
      let before = get(path).data;
      let after = getAfter(path).data;
      return validExistingPassState(before)
        && after.pasesUtilizados == before.pasesUtilizados + record.pasesRegistrados
        && after.pasesDisponibles == before.pasesDisponibles - record.pasesRegistrados
        && after.pasesDisponibles == record.pasesDisponiblesDespues
        && after.pasesUtilizados + after.pasesDisponibles == before.pases
        && after.checkinSecuencia == before.checkinSecuencia + 1
        && after.checkinSecuencia == record.checkinSecuencia
        && after.ultimoCheckinId == checkinId
        && after.llegadaRegistrada == true
        && after.estado == 'llego'
        && keepsFirstArrival(before, after)
        && after.fechaActualizacion == request.time;
    }

    function validPortalCheckinCreate(eventId, checkinId) {
      let record = request.resource.data;
      let guest = get(guestPath(eventId, record.invitadoId)).data;
      return checkinEnabled(eventId)
        && record.keys().hasAll([
          'eventId', 'invitadoId', 'codigoInvitado', 'nombreInvitado',
          'pasesRegistrados', 'pasesDisponiblesDespues', 'fechaHora',
          'registradoPor', 'metodo', 'resultado', 'checkinSecuencia'
        ])
        && record.keys().hasOnly([
          'eventId', 'invitadoId', 'codigoInvitado', 'nombreInvitado',
          'pasesRegistrados', 'pasesDisponiblesDespues', 'fechaHora',
          'registradoPor', 'metodo', 'resultado', 'checkinSecuencia'
        ])
        && record.eventId == eventId
        && record.invitadoId is string
        && checkinIdMatchesGuest(checkinId, record.invitadoId)
        && record.codigoInvitado is string
        && record.nombreInvitado is string
        && record.nombreInvitado == guest.nombre
        && record.pasesRegistrados is int
        && record.pasesRegistrados > 0
        && record.pasesRegistrados <= 999
        && record.pasesDisponiblesDespues is int
        && record.pasesDisponiblesDespues >= 0
        && record.fechaHora == request.time
        && record.registradoPor == request.auth.uid
        && record.metodo in ['manual', 'qr']
        && record.resultado in ['parcial', 'aprobado']
        && record.checkinSecuencia is int
        && record.checkinSecuencia > 0
        && checkinMatchesGuestAfter(eventId, checkinId, record)
        && record.resultado == (
          getAfter(guestPath(eventId, record.invitadoId)).data.pasesDisponibles > 0
            ? 'parcial'
            : 'aprobado'
        );
    }

    match /usuarios/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /eventos/{eventId} {
      allow get: if isInternalReader() || portalEnabled(eventId);
      allow list: if isInternalReader();
      // El Portal nunca recibe update sobre el documento padre.
      allow create, update, delete: if isPlatformManager();

      match /rsvpAccess/{token} {
        allow get: if isThemeEditor() || validPublicRsvpAccessGet(eventId, token);
        allow list: if isThemeEditor();
        allow create: if validRsvpAccessCreate(eventId, token);
        allow update: if validRsvpAccessUpdate(eventId, token);
        allow delete: if false;
      }

      match /rsvpPublic/{configKey} {
        allow get: if isThemeEditor() || validPublicRsvpConfigGet(eventId, configKey);
        allow list: if false;
        allow create, update: if isThemeEditor() && validRsvpPublicConfigWrite(eventId, configKey);
        allow delete: if false;
      }

      match /rsvpResponses/{token} {
        allow get: if isThemeEditor() || validPublicRsvpResponseGet(eventId, token);
        allow list: if isThemeEditor();
        allow create: if validInternalRsvpResponseMigration(eventId, token)
          || validPublicRsvpResponseWrite(eventId, token);
        allow update: if validPublicRsvpResponseUpdate(eventId, token);
        allow delete: if false;
      }

      match /rsvpState/{guestId} {
        allow get, list: if isInternalReader();
        allow create, update, delete: if false;
      }

      match /rsvpConflicts/{conflictId} {
        allow get, list: if isInternalReader();
        allow create, update, delete: if false;
      }

      match /invitados/{guestId} {
        allow get, list: if isInternalReader() || portalEnabled(eventId);
        allow create, delete: if isPlatformManager();
        allow update: if isPlatformManager() || validPortalGuestCheckin(eventId, guestId);
      }

      match /checkins/{checkinId} {
        allow get, list: if isInternalReader() || historyEnabled(eventId);
        allow create: if validPortalCheckinCreate(eventId, checkinId);
        allow update, delete: if false;
      }

      match /invitacion/{documentId} {
        allow get: if documentId in ['config', 'draft', 'publication', 'rsvp', 'rsvpPublication'] && isThemeEditor();
        allow list, delete: if false;
        allow create: if (documentId == 'config' && isThemeEditor() && validInvitationConfigWrite())
          || (documentId == 'draft' && isThemeEditor() && validInvitationDraftWrite(eventId))
          || (documentId == 'publication' && isThemeEditor() && validInvitationPublicationCreate(eventId))
          || (documentId == 'rsvp' && isThemeEditor() && validRsvpWrite(eventId))
          || (documentId == 'rsvpPublication' && isThemeEditor() && validRsvpPublicationCreate(eventId));
        allow update: if (documentId == 'config' && isThemeEditor() && validInvitationConfigWrite())
          || (documentId == 'draft' && isThemeEditor() && validInvitationDraftWrite(eventId))
          || (documentId == 'publication' && isThemeEditor() && validInvitationPublicationUpdate(eventId))
          || (documentId == 'rsvp' && isThemeEditor() && validRsvpWrite(eventId))
          || (documentId == 'rsvpPublication' && isThemeEditor() && validRsvpPublicationUpdate(eventId));
      }

      match /invitacion/publication/revisions/{revisionId} {
        allow get, list: if isThemeEditor();
        allow create: if isThemeEditor() && validInvitationRevisionCreate(eventId, revisionId);
        allow update, delete: if false;
      }

      match /invitacion/config/media/{mediaId} {
        allow get: if isThemeEditor();
        allow list: if false;
        allow create: if isThemeEditor() && validMediaDocumentCreate(eventId, mediaId);
        allow update: if isThemeEditor() && validMediaDocumentUpdate(eventId, mediaId);
        allow delete: if isThemeEditor();
      }

      match /invitacionPublic/{publicKey} {
        allow get: if isThemeEditor()
          || (validInvitationPublicKey(publicKey)
            && resource.data.eventId == eventId
            && resource.data.publicKey == publicKey);
        allow list: if false;
        allow create, update: if isThemeEditor()
          && validInvitationPublicProjection(eventId, publicKey);
        allow delete: if false;
      }
    }

    match /themes/{themeId} {
      allow get, list: if isThemeEditor();
      allow create, update, delete: if isThemeEditor();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
