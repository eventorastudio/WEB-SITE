rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // websiteRequests is accessed only through authenticated Cloud Functions.
    match /websiteRequests/{requestId} {
      allow read, write: if false;
    }

    // No public Firestore access remains in the current product.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
