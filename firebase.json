{
  "hosting": {
    "site": "eventorastudio-d6d95",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/invitaciones/paulette/", "destination": "/Invitaciones/paulette/index.html" },
      { "source": "/invitaciones/paulette/index.html", "destination": "/Invitaciones/paulette/index.html" },
      { "source": "/invitaciones/paulette/main.js", "destination": "/Invitaciones/paulette/main.js" },
      { "source": "/invitaciones/paulette/styles.css", "destination": "/Invitaciones/paulette/styles.css" },
      { "source": "/invitaciones/paulette/enhancements.css", "destination": "/Invitaciones/paulette/enhancements.css" },
      { "source": "/invitaciones/paulette/event-data.js", "destination": "/Invitaciones/paulette/event-data.js" },
      { "source": "/invitaciones/paulette/assets/favicon.ico", "destination": "/Invitaciones/paulette/assets/favicon.ico" },
      { "source": "/invitaciones/paulette/assets/stage-atmosphere.png", "destination": "/Invitaciones/paulette/assets/stage-atmosphere.png" },
      { "source": "/invitaciones/paulette/assets/stage-atmosphere.webp", "destination": "/Invitaciones/paulette/assets/stage-atmosphere.webp" },
      { "source": "/invitaciones/paulette/assets/FONDO%20INICIO.jpg", "destination": "/Invitaciones/paulette/assets/FONDO INICIO.jpg" },
      { "source": "/invitaciones/paulette/assets/fondo-inicio.webp", "destination": "/Invitaciones/paulette/assets/fondo-inicio.webp" },
      { "source": "/invitaciones/paulette/assets/paulette-qr.svg", "destination": "/Invitaciones/paulette/assets/paulette-qr.svg" },
      { "source": "/invitaciones/paulette/audio/inicio/README.md", "destination": "/Invitaciones/paulette/audio/inicio/README.md" },
      { "source": "/invitaciones/paulette/audio/invitacion/README.md", "destination": "/Invitaciones/paulette/audio/invitacion/README.md" },
      { "source": "/invitaciones/paulette/audio/inicio/inicio.mp3", "destination": "/Invitaciones/paulette/audio/inicio/inicio.mp3" },
      { "source": "/invitaciones/paulette/audio/invitacion/invitacion.mp3", "destination": "/Invitaciones/paulette/audio/invitacion/invitacion.mp3" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "codebase": "website-requests"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
